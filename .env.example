# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Instructions ────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local (never commit .env.local to git)
# 2. Replace the values above with your real Supabase project credentials
# 3. In Netlify dashboard → Site Settings → Environment Variables,
#    add both variables with the same values
